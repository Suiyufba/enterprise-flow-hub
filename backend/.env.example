# ── AI Provider ──
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Agent Runtime ──
# Runtime mode: "claude-code" or "legacy"
AGENT_RUNTIME=claude-code
# Manual fallback runtime
AGENT_FALLBACK_RUNTIME=legacy

# Optional custom free-code/Claude Code executable. The SDK-bundled executable
# is used when omitted.
CLAUDE_CODE_EXECUTABLE=
CLAUDE_CODE_WORKDIR=/data/claude-workdir

# ── Feishu Official MCP ──
# Create a self-built app in Feishu Open Platform. Keep these values out of git.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional. Required for APIs that must act as a specific user or read private resources.
FEISHU_USER_ACCESS_TOKEN=
FEISHU_DOMAIN=https://open.feishu.cn
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ── Durable schedulers and event workers (milliseconds) ──
# Scanners may run in every backend replica. Database dedupe keys and expiring
# leases ensure that only one worker owns a job at a time.
AUTOMATION_TIMEZONE=Asia/Shanghai
AUTOMATION_POLL_MS=60000
AUTOMATION_JOB_POLL_MS=5000
AUTOMATION_JOB_LEASE_MS=600000
EVENT_POLL_MS=5000
EVENT_LEASE_MS=120000
INTEGRATION_POLL_MS=5000
INTEGRATION_LEASE_MS=120000
MAINTENANCE_TIMEZONE=Asia/Shanghai
MAINTENANCE_POLL_MS=60000
MAINTENANCE_LEASE_MS=1800000
